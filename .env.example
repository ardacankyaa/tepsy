# Optional overrides — copy to the private app installation .env.
# Never commit actual secrets or device files.
PORT=3000

# Reverse proxy hostnames (LAN IPs and localhost work without this)
# TEPSY_ALLOWED_HOSTS=tepsy.restaurant.example

# Database path (default: prisma/dev.db)
# TEPSY_DATABASE_URL=file:C:/TEPSY/data/restaurant.db

# Session secret (auto-generated if unset; use 32+ random bytes)
# TEPSY_SESSION_SECRET=

# Device config, backups, menu images
# TEPSY_DEVICES_CONFIG_PATH=.tepsy/devices.json
# TEPSY_BACKUP_DIR=.tepsy/backups
# TEPSY_MENU_IMAGE_DIR=.tepsy/menu-images

# Installation base directory
# TEPSY_LOCAL_DATA_HOME=C:/Users/you/AppData/Local/TEPSY
# TEPSY_BIND_HOST=0.0.0.0

# Optional session logout revocation storage (default: .tepsy/revoked-sessions.db).
# Keep this local, private and persistent across restarts.
# TEPSY_SESSION_REVOCATION_PATH=C:/Users/you/AppData/Local/TEPSY/app/.tepsy/revoked-sessions.db

# Optional TokenX Connect Cloud bill export. Obtain production URLs and credentials
# from Token. Store real values only in the private installation's .env.
# Test URLs (not automatically enabled):
# TEPSY_TOKENX_AUTH_URL=https://test-api.devtokeninc.com/app-store/external/v1/auth/token
# TEPSY_TOKENX_API_URL=https://test-api.devtokeninc.com/dtokc/integration/v1
# TEPSY_TOKENX_CLIENT_ID=
# TEPSY_TOKENX_CLIENT_SECRET=
